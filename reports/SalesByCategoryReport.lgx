<?xml version="1.0" encoding="utf-8"?>
<Report ID="SalesByCategoryReport"
        Caption="Revenue by Product Category"
        Category="Executive"
        Description="Aggregated item sales, units sold, and gross revenue across product categories."
        SecurityRightID="Admin"
        ShowInMenu="True"
        SavedBy="LogiInfoStudio"
        SavedAt="2026-11-19 12:00:00"
        EngineVersion="14.0">
  <ReportMeta SortOrder="10" Icon="bar-chart" />
  <Body>
    <Division ID="divHeader" HtmlDiv="True">
      <Label ID="lblTitle" Caption="My Guitar Shop - Sales by Category" Class="ThemeTextLargest" />
      <LineBreak LineCount="2" />
    </Division>
    <Division ID="divContent" HtmlDiv="True">
      <ChartCanvas ID="chartRevenueByCategory" ChartWidth="700" ChartHeight="340" ChartCaption="Gross Revenue by Category ($)">
        <DataLayer Type="SQL" ID="dlCategoryRevenue" ConnectionID="connMyGuitarShop" Source="SELECT c.category_name, SUM((oi.item_price - oi.discount_amount) * oi.quantity) AS net_sales FROM categories c JOIN products p ON c.category_id = p.category_id JOIN order_items oi ON p.product_id = oi.product_id GROUP BY c.category_id, c.category_name ORDER BY net_sales DESC" />
        <Series Type="Bar" ChartXDataColumn="category_name" ChartYDataColumn="net_sales" Color="#dd6b20">
          <DataLabels Format="#,##0.00" />
        </Series>
        <ChartXAxis AxisCaption="Product Category" />
        <ChartYAxis AxisCaption="Net Sales ($)" />
      </ChartCanvas>
      <LineBreak LineCount="2" />
      <DataTable ID="dtCategorySales" AjaxPaging="False" AltRowClass="ThemeAlternatingRow" BorderColor="#CCCCCC" CellPadding="4" CellSpacing="0" Class="ThemeDataTable" Width="100" WidthScale="%">
        <DataLayer Type="SQL" ID="dlCategoryTable" ConnectionID="connMyGuitarShop" Source="SELECT c.category_name, SUM(oi.quantity) AS units_sold, ROUND(SUM(oi.item_price * oi.quantity), 2) AS gross_sales, ROUND(SUM(oi.discount_amount * oi.quantity), 2) AS total_discounts, ROUND(SUM((oi.item_price - oi.discount_amount) * oi.quantity), 2) AS net_sales FROM categories c JOIN products p ON c.category_id = p.category_id JOIN order_items oi ON p.product_id = oi.product_id GROUP BY c.category_id, c.category_name ORDER BY net_sales DESC" />
        <DataTableColumn ID="colCategoryName" Header="Category">
          <Label ID="lblCategoryName" Caption="@Data.category_name~" />
          <DataColumnSort DataColumn="category_name" DataType="Text" />
        </DataTableColumn>
        <DataTableColumn ID="colUnitsSold" Header="Units Sold" Class="ThemeAlignRight">
          <Label ID="lblUnitsSold" Caption="@Data.units_sold~" />
          <DataColumnSort DataColumn="units_sold" DataType="Number" />
        </DataTableColumn>
        <DataTableColumn ID="colGrossSales" Header="Gross Sales" Class="ThemeAlignRight">
          <Label ID="lblGrossSales" Caption="@Data.gross_sales~" />
          <DataColumnSort DataColumn="gross_sales" DataType="Number" />
        </DataTableColumn>
        <DataTableColumn ID="colDiscounts" Header="Total Discounts" Class="ThemeAlignRight">
          <Label ID="lblDiscounts" Caption="@Data.total_discounts~" />
          <DataColumnSort DataColumn="total_discounts" DataType="Number" />
        </DataTableColumn>
        <DataTableColumn ID="colNetSales" Header="Net Sales" Class="ThemeAlignRight">
          <Label ID="lblNetSales" Caption="@Data.net_sales~" />
          <DataColumnSort DataColumn="net_sales" DataType="Number" />
        </DataTableColumn>
      </DataTable>
    </Division>
  </Body>
  <ideTestParams />
</Report>